rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules, then Publish.
//
// Trust model: this is a small, low-stakes family app with no real login —
// "devices" are anonymous Firebase Auth identities, and the shared passcode
// in the app is just a soft deterrent (the app's source, including the
// passcode, is public on GitHub Pages). These rules stop casual mistakes and
// require an anonymous session to write, but a determined visitor with
// developer tools could still write malformed data. Don't store anything
// sensitive in this database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /slots/{slotId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['date', 'time', 'bookings', 'totalVisitors'])
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.bookings is list
        && request.resource.data.totalVisitors is int
        && request.resource.data.totalVisitors >= 0
        && request.resource.data.totalVisitors <= 3;

      allow delete: if false;
    }
  }
}
